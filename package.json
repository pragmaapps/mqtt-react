{
  "name": "mqtt-react",
  "version": "0.0.2",
  "description": "Connecting MQQT to React Components",
  "main": "./lib/index.js",
  "browser": "./dist/mqtt-react.js",
  "scripts": {
    "build:lib": "NODE_ENV=development babel src --out-dir lib",
    "build:umd": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 webpack --config=webpack.config.js",
    "build:umd:min": "cross-env NODE_ENV=production webpack --config=webpack.config.js",
    "build": "npm run build:lib && npm run build:umd",
    "test": "cross-env NODE_ENV=test ava"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeKs0r/mqtt-react.git"
  },
  "keywords": [
    "react",
    "mqtt"
  ],
  "author": "Marc Höffl <marc.hoeffl@gmail.com>",
  "license": "MIT",
  "ava": {
    "files": [
      "./test/*.spec.js"
    ],
    "failFast": true,
    "tap": true,
    "verbose": true,
    "require": [
      "babel-register"
    ],
    "babel": "inherit"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "mqtt": "5.14.0"
  },
  "peerDependencies": {
    "prop-types": "^15.8.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^9.1.2",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "cross-env": "^4.0.0",
    "crypto-browserify": "^3.12.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "stream-browserify": "^3.0.0",
    "thread-loader": "^3.0.4",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.0.1"
  }
}
